{
  "name": "dwelling-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "gtfs:scrape": "tsx src/gtfs-scraper/index.ts",
    "gtfs:zip": "tsx src/gtfs-scraper/zipGtfs.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "test": "tsc -p tsconfig.json && node dist/tests/runTests.js",
    "test:otp": "tsx tests/testOtp.ts",
    "test:integration": "tsx tests/catalogIntegration.ts",
    "test:duplicates": "tsx tests/duplicateUndoIntegration.ts",
    "test:browser": "tsx tests/browserSmoke.ts",
    "test:browser:detail": "tsx tests/listingDetailSmoke.ts",
    "test:photo-pilot": "tsx src/scripts/pilotPhotoRepair.ts",
    "ranking:pilot": "tsx src/scripts/pilotPersonalRanking.ts",
    "test:capture-fixtures": "tsx src/scripts/captureSourceFixtures.ts",
    "db:backfill-transit": "tsx src/scripts/backfillTransitTime.ts",
    "db:normalize-catalog": "tsx src/scripts/normalizeCatalog.ts",
    "db:exclude-ineligible": "tsx src/scripts/excludeIneligible.ts",
    "db:reconcile-duplicates": "tsx src/scripts/reconcileDuplicates.ts",
    "db:audit-duplicates": "tsx src/scripts/auditDuplicates.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@googlemaps/polyline-codec": "1.0.28",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tanstack/react-query": "5.105.3",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "leaflet": "1.9.4",
    "lucide-react": "1.68.0",
    "node-cron": "4.6.0",
    "pg": "8.22.0",
    "pg-boss": "12.38.0",
    "pino": "10.3.1",
    "playwright": "1.61.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tough-cookie": "^6.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.1.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "prisma": "7.8.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
